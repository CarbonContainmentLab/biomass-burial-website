    "@deck.gl/react": "9.3.10",
    "@luma.gl/core": "9.3.6",
    "@luma.gl/engine": "9.3.6",
    "@math.gl/web-mercator": "4.1.0",
    "@protomaps/basemaps": "^5.7.2",
    "geotiff": "3.0.5",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0",
    "proj4": "2.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
